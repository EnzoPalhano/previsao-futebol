# ============================================================
# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA vai para o Git (regra da Fase 10).
#   Windows:    Copy-Item .env.exemplo .env
#   Mac/Linux:  cp .env.exemplo .env
# Estas chaves so sao necessarias a partir da FASE 10.
# ============================================================

# API de futebol (lesoes, suspensoes, escalacoes) - ex.: api-sports.io
API_FUTEBOL_CHAVE=

# API da Anthropic (extrair JSON de noticias) - console.anthropic.com
ANTHROPIC_API_KEY=

# API de noticias (opcional, se nao usar RSS)
NEWS_API_CHAVE=
